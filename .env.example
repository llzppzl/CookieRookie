# CookieRookie settings
# Copy this file to .env and fill in your values.
# Each setting can also come from an environment variable of the same name,
# which wins over this file (e.g. export ANTHROPIC_API_KEY=...).
# Quotes around a value are optional: KEY=value and KEY="value" both work.

# API key (required)
# Any provider with an Anthropic-compatible API works:
# - Minimax: https://api.minimax.io
# - DeepSeek: https://api.deepseek.com
# - Kimi (Moonshot AI): https://api.moonshot.ai
# - GLM (Z.ai): https://api.z.ai
# - Anthropic (Claude): https://api.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Model ID (required)
# For example: MiniMax-M2.5, deepseek-chat, kimi-k2.5, glm-5, claude-sonnet-4-6
MODEL_ID=MiniMax-M2.5

# Base URL (required)
# Pick the one for your provider:
# Minimax:    https://api.minimax.io/anthropic
# DeepSeek:    https://api.deepseek.com/anthropic
# Kimi:        https://api.moonshot.ai/anthropic
# GLM:         https://api.z.ai/api/anthropic
# Anthropic:   https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
